{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "default_secret_key_1234567890",
    "Issuer": "Valuator",
    "Audience": "ValuatorClient"
  },
  "ConnectionStrings": {
    "Redis": "${REDIS_CONNECTION},password=${REDIS_PASSWORD}"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:80",
        "Protocols": "Http1"
      }
    }
  }
}
